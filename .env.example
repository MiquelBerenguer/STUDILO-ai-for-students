# Copy to .env (gitignored) and fill in. Secrets live ONLY here; model choices live in backend/config/models.yaml.
# At startup the backend checks that every provider referenced in models.yaml has its key set.

# --- LLM providers (fill only the ones you use) ---
ANTHROPIC_API_KEY=                       # Claude models (provider: anthropic)
OPENAI_API_KEY=                          # OpenAI models (provider: openai)
DEEPSEEK_API_KEY=                        # DeepSeek models (provider: deepseek)
GOOGLE_API_KEY=                          # Gemini models via Google AI Studio (provider: google)
OPENROUTER_API_KEY=                      # Any model via OpenRouter (provider: openrouter)
OLLAMA_BASE_URL=http://localhost:11434   # local models, no key needed (provider: ollama)
# --- Embeddings ---
EMBEDDINGS_API_KEY=                      # empty if using a local embedding model (default: fastembed, local)
# --- App ---
APP_SECRET_KEY=                          # for auth sessions; `make setup` generates one (>= 32 chars)
DATABASE_URL=sqlite:///./data/app.db # relative paths resolve from the repo root

# --- Optional tuning (defaults shown; uncomment to override) ---
# DATA_DIR=./data                        # uploads, database and local model cache
# COOKIE_SECURE=false                    # set true when served over HTTPS
# SESSION_TTL_DAYS=14                    # login session lifetime
# MAX_UPLOAD_MB=25                       # per-file upload limit
# ENABLE_BACKGROUND=true                 # run the orchestrator worker + scheduler in the API process
# SCHEDULER_INTERVAL_SECONDS=30          # how often the Planner checks class slots / exam dates
# WORKER_CONCURRENCY=2                   # jobs processed in parallel
# EXAM_PACK_PRACTICE_EXAMS=2                 # practice exams per Exam Pack
# EXAM_PACK_QUESTIONS_PER_EXAM=4         # verified questions per practice exam
# MODELS_CONFIG=backend/config/models.yaml
